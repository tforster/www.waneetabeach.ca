{
  "$schema": "./../../node_modules/wrangler/config-schema.json",
  "name": "waneetabeach-auth",
  "main": "./src/index.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BASE_URL": "http://localhost:8787"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "waneetabeach-auth",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["no-reply@waneetabeach.ca"]
    }
  ],
  "env": {
    "production": {
      "name": "waneetabeach-auth",
      "vars": {
        "BASE_URL": "https://waneetabeach.ca"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "waneetabeach-auth",
          "database_id": "493bbb5a-9da4-4baa-bf8f-09c037902386",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["no-reply@waneetabeach.ca"]
        }
      ]
    }
  }
}
