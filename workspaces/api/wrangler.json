{
  "$schema": "./../../node_modules/wrangler/config-schema.json",
  "name": "waneetabeach-ca",
  "main": "./src/index.js",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waneetabeach",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["no-reply@waneetabeach.ca"]
    }
  ],
  "vars": {
    "FROM_ADDRESS": "no-reply@waneetabeach.ca"
  },
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "waneetabeach-auth"
    }
  ],
  "env": {
    "production": {
      "name": "waneetabeach-ca",
      "main": "./src/index.js",
      "compatibility_date": "2025-05-01",
      "assets": {
        "directory": "../app/dist",
        "not_found_handling": "404-page"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "waneetabeach",
          "database_id": "380ecce7-af1b-423d-b092-02b21c8f51f8",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["no-reply@waneetabeach.ca"]
        }
      ],
      "vars": {
        "FROM_ADDRESS": "no-reply@waneetabeach.ca"
      },
      "services": [
        {
          "binding": "AUTH_SERVICE",
          "service": "waneetabeach-auth"
        }
      ]
    }
  }
}
