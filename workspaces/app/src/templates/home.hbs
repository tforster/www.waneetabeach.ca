<!doctype html>
<html lang="en">
  <head>
    {{> components/head.hbs}}
  </head>
  <body>
    {{> components/header.hbs}}

    <main>

      <section class="hero-section" aria-label="Waneeta Beach entrance">
        <div class="hero-image-wrapper">
          <picture>
            <source
              srcset="/files/entrance-sign-1200.webp 1200w, /files/entrance-sign-800.webp 800w, /files/entrance-sign-400.webp 400w"
              sizes="(min-width: 768px) calc(100vw - 96px), calc(100vw - 32px)"
              type="image/webp">
            <img
              src="/files/entrance-sign-1200.jpg"
              srcset="/files/entrance-sign-1200.jpg 1200w, /files/entrance-sign-800.jpg 800w, /files/entrance-sign-400.jpg 400w"
              sizes="(min-width: 768px) calc(100vw - 96px), calc(100vw - 32px)"
              alt="Waneeta Beach entrance sign — hand-painted letters on weathered wood surrounded by summer foliage"
              width="1200" height="900">
          </picture>
        </div>
      </section>

      <div class="page-intro">
        <h1>Waneeta Beach</h1>
        <p>A private cottage community on the north shore of Lake Erie, Ontario.</p>
      </div>

      <div class="container">

        <section class="notice" aria-label="Community notice">
          <span class="material-symbols-outlined" aria-hidden="true">warning</span>
          <p>Please observe the strict <strong>15 km/h speed limit</strong> on all community roads to ensure the safety of pedestrians, children, and pets near the shoreline.</p>
        </section>

        <section aria-labelledby="community-updates-heading">
          <h2 id="community-updates-heading">Community Updates</h2>
          <div class="widget-grid">

            <article id="widget-weather">
              <span class="card-icon material-symbols-outlined" aria-hidden="true">partly_cloudy_day</span>
              <h3>Weather</h3>
              <p class="widget-body">Loading&hellip;</p>
              <a
                href="https://open-meteo.com/en/docs#latitude=42.6559&longitude=-81.0089"
                target="_blank"
                rel="noopener noreferrer"
                class="card-read-more">
                View source
                <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px">arrow_forward</span>
              </a>
            </article>

            <article id="widget-garbage">
              <span class="card-icon material-symbols-outlined" aria-hidden="true">delete</span>
              <h3>Garbage Day</h3>
              <p class="widget-body">Loading&hellip;</p>
              <a
                href="https://www.malahide.ca/public/download/files/333206"
                target="_blank"
                rel="noopener noreferrer"
                class="card-read-more">
                View schedule
                <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px">arrow_forward</span>
              </a>
            </article>

            <article id="widget-catfish">
              <span class="card-icon material-symbols-outlined" aria-hidden="true">water</span>
              <h3>Catfish Creek</h3>
              <p class="widget-body">Loading&hellip;</p>
              <a
                id="widget-catfish-link"
                href="https://www.catfishcreek.ca/programs/water-management/flood-forecasting-and-warning/flood-notices/"
                target="_blank"
                rel="noopener noreferrer"
                class="card-read-more">
                View advisories
                <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px">arrow_forward</span>
              </a>
            </article>

            <article id="widget-power" class="widget-disabled" aria-disabled="true">
              <span class="card-icon material-symbols-outlined" aria-hidden="true">bolt</span>
              <h3>Power</h3>
              <p class="widget-body">Coming soon</p>
              <span class="card-read-more" aria-hidden="true">&mdash;</span>
            </article>

          </div>
        </section>

      </div>

    </main>

    {{> components/footer.hbs}}
  </body>
</html>
