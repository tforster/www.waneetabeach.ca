<!doctype html>
<html lang="en">
  <head>
    {{> components/head.hbs}}
  </head>
  <body class="login-page">
    {{> components/header.hbs navLogin=true}}
    <main class="container login-container">
      <article>
        <hgroup>
          <h1>Member login</h1>
          <p>Waneeta Beach members area</p>
        </hgroup>
        <form id="login-form">
          <p id="login-error" class="login-error" hidden></p>
          <label for="email">
            Email address
            <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email">
          </label>
          <label for="password">
            Password
            <input type="password" id="password" name="password" required autocomplete="current-password">
          </label>
          <button type="submit" class="button">Sign in</button>

          <p style="margin-block-start: var(--space-4); text-align: center;">
            <a href="/forgot-password">Forgot your password?</a>
          </p>
        </form>
      </article>
    </main>
    {{> components/footer.hbs}}
    <script type="module" src="/login.js" defer></script>
  </body>
</html>
