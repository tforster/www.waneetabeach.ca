<!doctype html>
<html lang="en">
  <head>
    {{> components/head.hbs}}
  </head>
  <body class="forgot-password-page">
    {{> components/header.hbs navLogin=true}}
    <main class="container forgot-password-container">
      <article>
        <hgroup>
          <h1>Reset Your Password</h1>
          <p>Enter your email to receive a password reset link</p>
        </hgroup>

        <form id="forgot-password-form">
          <p id="form-error" class="form-error" hidden></p>

          <label for="email">
            Email address
            <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email">
          </label>

          <button type="submit" class="button">Send Reset Link</button>

          <p style="margin-block-start: var(--space-4); text-align: center;">
            <a href="/login">Back to Sign In</a>
          </p>
        </form>

        <div id="success-message" hidden style="margin-block-start: var(--space-6);">
          <p role="alert" style="color: var(--color-primary); font-weight: 500;">
            ✓ Check your email for a password reset link. It expires in 15 minutes.
          </p>
        </div>
      </article>
    </main>
    {{> components/footer.hbs}}
    <script type="module" src="/forgot-password.js" defer></script>
  </body>
</html>
