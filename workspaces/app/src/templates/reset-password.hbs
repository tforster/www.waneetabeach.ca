<!doctype html>
<html lang="en">
  <head>
    {{> components/head.hbs}}
  </head>
  <body class="reset-password-page">
    {{> components/header.hbs navLogin=true}}
    <main class="container reset-password-container">
      <article>
        <hgroup>
          <h1>Create a New Password</h1>
          <p>Enter a new password for your account</p>
        </hgroup>

        <div id="invalid-token" hidden>
          <p role="alert" style="color: var(--color-error); margin-block-end: var(--space-4);">
            This password reset link has expired or is invalid. 
            <a href="/forgot-password">Request a new link</a>
          </p>
        </div>

        <form id="reset-password-form" hidden>
          <p id="reset-error" class="form-error" hidden></p>

          <label for="password">
            New password
            <input type="password" id="password" name="password" required autocomplete="new-password" minlength="8" placeholder="At least 8 characters">
          </label>

          <label for="confirm-password">
            Confirm password
            <input type="password" id="confirm-password" name="confirm" required autocomplete="new-password" minlength="8" placeholder="Confirm your new password">
          </label>

          <p id="password-mismatch" role="alert" hidden style="color: var(--color-error); margin-block-end: var(--space-4);">
            Passwords do not match.
          </p>

          <button type="submit" class="button">Update Password</button>

          <p style="margin-block-start: var(--space-4); text-align: center;">
            <a href="/login">Back to Sign In</a>
          </p>
        </form>

        <div id="success-message" hidden style="margin-block-start: var(--space-6);">
          <p role="alert" style="color: var(--color-primary); font-weight: 500; margin-block-end: var(--space-3);">
            ✓ Your password has been reset successfully.
          </p>
          <p style="text-align: center;">
            <a href="/login" class="button">Sign In with New Password</a>
          </p>
        </div>
      </article>
    </main>
    {{> components/footer.hbs}}
    <script type="module" src="/reset-password.js" defer></script>
  </body>
</html>
