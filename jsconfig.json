{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "paths": {},
    "skipLibCheck": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "types": []
  },
  "exclude": [
    "node_modules",
    "dist",
    ".wrangler",
    "**/.cloudflare/**",
    "cache",
    "story",
    "workspaces/*/tests/**",
    "workspaces/*/test/**",
    "**/*.test.js",
    "**/node_modules/**"
  ],
  "include": [
    "workspaces/api/src/**/*.js",
    "workspaces/auth/src/**/*.js",
    "workspaces/app/src/scripts/**/*.js"
  ]
}
